{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": {
      "type": "swc",
      "options": {
        "ignore": ["**/*.spec.ts", "**/testing/**"]
      }
    },
    "typeCheck": false,
    "assets": ["common/assets/**/*"],
    "watchAssets": true
  }
}
