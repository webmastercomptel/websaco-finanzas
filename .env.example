# ------------------------------------------------------------------
# Copiá este archivo a ".env" y completá los valores reales.
# NUNCA subas un ".env" real a ningún repositorio ni lo compartas.
#
# No hace falta instalar bases de datos: los servicios que usa el
# sistema viven en internet. Cada uno te da UNA dirección de conexión
# que se pega tal cual acá abajo.
# ------------------------------------------------------------------

# Entorno en el que corre la aplicación. Dejalo en "development" para
# trabajar en tu máquina. En el servidor de producción va "production".
NODE_ENV=development

# Puerto donde escucha el servidor. 3000 sirve para desarrollo local; en
# producción normalmente lo define la plataforma de hosting.
PORT=3000


# ------------------------------------------------------------------
# Base de datos (MongoDB Atlas)
#
# De dónde sale: entrá a cloud.mongodb.com, elegí tu base de datos y
# apretá el botón "Connect" > "Drivers". Ahí te muestra una línea que
# empieza con "mongodb+srv://". Copiala entera y pegala acá.
#
# OJO con dos cosas al pegarla:
#  - donde dice <password>, poné la contraseña real (sin los signos < >)
#  - antes del "?" va el nombre de la base: /websaco-finanzas
#
# Tiene que empezar con "mongodb+srv://" o "mongodb://". Si pegás la
# dirección de la página web de Atlas, el servidor te lo va a avisar.
MONGODB_URI=


# ------------------------------------------------------------------
# Memoria rápida y tareas en segundo plano (Redis Cloud)
#
# De dónde sale: entrá a redis.io, abrí tu base y buscá la sección de
# conexión ("Connect" / "Public endpoint"). Necesitás la dirección
# completa, la que incluye el usuario y la contraseña.
#
# Suele empezar con "rediss://" (con dos eses, que significa que la
# conexión va cifrada) o con "redis://".
REDIS_URL=


# ------------------------------------------------------------------
# Ingreso de usuarios (Firebase)
#
# ES OBLIGATORIA. El servidor la usa para comprobar que quien entra
# tiene una sesión válida, así que sin este valor no arranca (y te lo
# dice con un error claro).
#
# Solo se usa para VERIFICAR quién entra. Esta aplicación nunca crea,
# cambia ni borra usuarios: las cuentas se dan de alta a mano desde la
# consola de Firebase.
#
# De dónde sale: en la consola de Firebase (console.firebase.google.com),
# entrá al proyecto > ícono de engranaje > "Configuración del proyecto" >
# pestaña "Cuentas de servicio" > botón "Generar nueva clave privada".
# Eso descarga un archivo .json. Convertí ese archivo completo a Base64
# (por ejemplo con `base64 -w 0 archivo.json` en Linux/Mac, o
# `certutil -encode archivo.json archivo.txt` en Windows) y pegá el
# resultado acá, todo en una sola línea.
FIREBASE_SERVICE_ACCOUNT_BASE64=


# ------------------------------------------------------------------
# Correo de la única cuenta que por ahora puede operar el sistema.
#
# Todavía no existen los usuarios y roles propios de esta aplicación,
# así que se usa este atajo: la persona que entre con ESTE correo tiene
# acceso total. Cualquier otra que entre con una sesión válida queda
# adentro pero sin ningún permiso, y no puede hacer nada.
#
# Tiene que ser el correo de un usuario creado a mano en la consola de
# Firebase.
ROOT_ADMIN_EMAIL=


# ------------------------------------------------------------------
# Direcciones web autorizadas a usar esta API.
#
# El navegador solo deja que una página lea respuestas de un servidor si
# ese servidor la autorizó. Acá va la dirección donde vive la aplicación
# web, sin barra al final y separadas por coma si hay varias:
#
#   https://finanzas.ejemplo.com
#
# EN DESARROLLO PODÉS DEJARLA VACÍA: si trabajás en tu computadora, el
# servidor acepta automáticamente cualquier dirección que empiece con
# "localhost". En producción es obligatoria.
CORS_ORIGINS=
